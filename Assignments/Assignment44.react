
import React, { useState } from "react";

function App() {

  const [following, setFollowing] = useState(false);
  const [cart, setCart] = useState([]);

  // Product Details
  const products = [
    {
      id: 1,
      name: "Laptop",
      price: 55000,
      rating: "⭐⭐⭐⭐⭐",
      image: "https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=400"
    },
    {
      id: 2,
      name: "Mobile",
      price: 25000,
      rating: "⭐⭐⭐⭐",
      image: "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=400"
    },
    {
      id: 3,
      name: "Headphones",
      price: 2000,
      rating: "⭐⭐⭐⭐⭐",
      image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=400"
    },
    {
      id: 4,
      name: "Smart Watch",
      price: 3500,
      rating: "⭐⭐⭐⭐",
      image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400"
    },
    {
      id: 5,
      name: "Camera",
      price: 40000,
      rating: "⭐⭐⭐⭐⭐",
      image: "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=400"
    },
    {
      id: 6,
      name: "Shoes",
      price: 3000,
      rating: "⭐⭐⭐⭐",
      image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400"
    }
  ];

  // Add to Cart Function
  function addToCart(product) {
    setCart([...cart, product]);
    alert(product.name + " Added to Cart!");
  }

  return (
    <div>

      <style>{`

        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }

        body {
          font-family: Arial, sans-serif;
          background: #f4f4f4;
        }

        /* NAVBAR */

        .navbar {
          display: flex;
          justify-content: space-between;
          align-items: center;
          background: #222;
          padding: 20px 40px;
          color: white;
          flex-wrap: wrap;
        }

        .logo {
          color: orange;
          font-size: 28px;
        }

        .nav-links {
          display: flex;
          gap: 25px;
        }

        .nav-links a {
          color: white;
          text-decoration: none;
          font-size: 17px;
        }

        .nav-links a:hover {
          color: orange;
        }

        .login-btn {
          background: orange;
          color: white;
          border: none;
          padding: 10px 22px;
          border-radius: 5px;
          cursor: pointer;
        }

        /* PROFILE CARD */

        .profile-section {
          display: flex;
          justify-content: center;
          padding: 50px 20px;
        }

        .profile-card {
          background: white;
          width: 320px;
          text-align: center;
          padding: 30px;
          border-radius: 15px;
          box-shadow: 0 4px 12px #ccc;
        }

        .profile-img {
          width: 120px;
          height: 120px;
          border-radius: 50%;
          object-fit: cover;
          margin-bottom: 15px;
        }

        .profile-card h2 {
          margin-bottom: 8px;
        }

        .profile-card h4 {
          color: #777;
          margin-bottom: 15px;
        }

        .profile-card p {
          line-height: 1.6;
          margin-bottom: 20px;
        }

        .follow-btn {
          background: #007bff;
          color: white;
          border: none;
          padding: 10px 30px;
          border-radius: 5px;
          cursor: pointer;
        }

        /* PRODUCT SECTION */

        .product-section {
          padding: 40px 30px;
          text-align: center;
        }

        .product-section h1 {
          margin-bottom: 20px;
          font-size: 32px;
        }

        .cart-count {
          margin-bottom: 25px;
          font-weight: bold;
        }

        .product-container {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 25px;
          max-width: 1100px;
          margin: auto;
        }

        .product-card {
          background: white;
          padding: 20px;
          border-radius: 10px;
          box-shadow: 0 3px 10px #ccc;
          transition: 0.3s;
        }

        .product-card:hover {
          transform: translateY(-5px);
        }

        .product-card img {
          width: 100%;
          height: 180px;
          object-fit: contain;
          margin-bottom: 15px;
        }

        .product-card h3 {
          margin-bottom: 10px;
        }

        .product-card h4 {
          color: green;
          margin-bottom: 10px;
        }

        .product-card p {
          margin-bottom: 15px;
        }

        .cart-btn {
          background: #28a745;
          color: white;
          border: none;
          padding: 10px 20px;
          border-radius: 5px;
          cursor: pointer;
        }

        .cart-btn:hover {
          background: #218838;
        }

        /* FOOTER */

        footer {
          background: #222;
          color: white;
          text-align: center;
          padding: 20px;
          margin-top: 30px;
        }

        /* RESPONSIVE DESIGN */

        @media (max-width: 768px) {
          .navbar {
            flex-direction: column;
            gap: 20px;
          }

          .nav-links {
            flex-wrap: wrap;
            justify-content: center;
          }

          .product-container {
            grid-template-columns: repeat(2, 1fr);
          }
        }

        @media (max-width: 480px) {
          .product-container {
            grid-template-columns: 1fr;
          }

          .navbar {
            padding: 20px;
          }
        }

      `}</style>

      {/* NAVBAR */}

      <nav className="navbar">

        <h2 className="logo">MyStore</h2>

        <div className="nav-links">
          <a href="#home">Home</a>
          <a href="#about">About</a>
          <a href="#services">Services</a>
          <a href="#contact">Contact</a>
        </div>

        <button
          className="login-btn"
          onClick={() => alert("Login Clicked")}
        >
          Login
        </button>

      </nav>

      {/* PROFILE CARD */}

      <section className="profile-section" id="about">

        <div className="profile-card">

          <img
            src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=300"
            alt="Profile"
            className="profile-img"
          />

          <h2>Arun Kumar</h2>

          <h4>Frontend Developer</h4>

          <p>
            I am a passionate web developer.
            I love creating beautiful and responsive
            websites using React.
          </p>

          <button
            className="follow-btn"
            onClick={() => setFollowing(!following)}
          >
            {following ? "Following" : "Follow"}
          </button>

        </div>

      </section>

      {/* PRODUCT PAGE */}

      <section className="product-section" id="products">

        <h1>Our Products</h1>

        <p className="cart-count">
          Cart Items: {cart.length}
        </p>

        <div className="product-container">

          {products.map((product) => (

            <div className="product-card" key={product.id}>

              <img
                src={product.image}
                alt={product.name}
              />

              <h3>{product.name}</h3>

              <h4>₹{product.price}</h4>

              <p>{product.rating}</p>

              <button
                className="cart-btn"
                onClick={() => addToCart(product)}
              >
                Add to Cart
              </button>

            </div>

          ))}

        </div>

      </section>

      {/* FOOTER */}

      <footer id="contact">
        <p>© 2026 MyStore. All Rights Reserved.</p>
      </footer>

    </div>
  );
