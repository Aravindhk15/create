STEP 7: Call all components inside App.jsx

Open src/App.jsx, remove the existing code and paste:

import Header from './components/Header'
import Navbar from './components/Navbar'
import Student from './components/Student'
import Footer from './components/Footer'

function App() {
    return (
        <div>
            <Header />
            <Navbar />
            <Student />
            <Footer />
        </div>
    )
}

export default App;
